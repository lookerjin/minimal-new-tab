{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.5.13",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage",
    "bookmarks",
    "favicon"
  ],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://suggestqueries.google.com/*",
    "https://www.baidu.com/*",
    "https://api.bing.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "zh_CN"
}
