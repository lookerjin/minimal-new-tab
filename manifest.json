{
  "manifest_version": 3,
  "name": "Minimal New Tab",
  "version": "1.5.6",
  "description": "本地优先的新标签页：搜索、按需搜索建议、壁纸和书签导航。",
  "permissions": [
    "storage",
    "bookmarks",
    "favicon"
  ],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://suggestqueries.google.com/*",
    "https://www.baidu.com/*",
    "https://api.bing.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
