{
  "manifest_version": 3,
  "name": "Minimal New Tab",
  "version": "1.5.0",
  "description": "极简本地新标签页扩展",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["bookmarks", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
